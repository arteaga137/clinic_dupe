# Dependencias (se reinstalan con `npm install`, nunca se suben a GitHub)
node_modules/

# Frontend compilado (se genera con `npm run build`)
client/dist/

# Restos de la versión SQLite (si los tuvieras en local)
server/data/
*.db
*.db-shm
*.db-wal

# Variables de entorno y secretos (¡la contraseña de la base de datos!)
.env
.env.*
# ...excepto la plantilla, que sí se sube para que otros sepan qué rellenar
!.env.example

# Archivos del sistema / editores
.DS_Store
.vscode/
.idea/
*.log
