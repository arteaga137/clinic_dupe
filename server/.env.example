# =====================================================================
# Variables de entorno del servidor
# ---------------------------------------------------------------------
# 1. Copia este archivo como server/.env  →  cp server/.env.example server/.env
# 2. Rellena los valores. El archivo .env NO se sube a GitHub (.gitignore).
# =====================================================================

# Base de datos que usa la app. En Supabase: botón "Connect" (arriba en el
# panel del proyecto) → "Session pooler" → copia la URI y sustituye
# [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=ppostgresql://postgres.uadgwtaiebhacflvsbdx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# (Opcional) Base de datos SOLO para `npm test`. Los tests la BORRAN entera,
# así que tiene que ser otra distinta de DATABASE_URL: por ejemplo un
# Postgres local, o un segundo proyecto de Supabase.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinic_test
