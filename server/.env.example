# =====================================================================
# Variables de entorno del servidor
# ---------------------------------------------------------------------
# ESTE ARCHIVO ES UNA PLANTILLA Y SÍ SE SUBE A GITHUB: NUNCA PONGAS AQUÍ
# TU CONTRASEÑA REAL. Los valores reales van en server/.env (no se sube).
#
# 1. Copia este archivo como server/.env  →  cp server/.env.example server/.env
# 2. Rellena los valores en server/.env
# =====================================================================

# Base de datos que usa la app. En Supabase: botón "Connect" → "Direct" →
# Method: "Session pooler" → copia la URI y sustituye [YOUR-PASSWORD] por
# la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:TU-CONTRASEÑA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# (Opcional) Base de datos SOLO para `npm test`. Los tests la BORRAN entera,
# así que tiene que ser otra distinta de DATABASE_URL: por ejemplo un
# Postgres local, o un segundo proyecto de Supabase.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinic_test
